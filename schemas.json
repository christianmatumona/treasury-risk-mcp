    {
      "name": "liquidity_forecast",
      "route": "/liquidity",
      "price_usd": "0.50",
      "summary": "Deterministic liquidity forecast",
      "description": "Projects daily cash balance from opening cash and a list of scheduled cash flow events over a forecast horizon, flags minimum-buffer breaches, and classifies liquidity status. Optionally also computes standard working-capital ratios (DSO/DPO/DIO/cash conversion cycle) from a supplied balance snapshot. Requires USDC payment via the x402 protocol (Circle Gateway) — see the 402 response for the payment flow.",
      "inputSchema": {
        "type": "object",
        "required": [
          "openingCash",
          "horizonDays",
          "minimumCashBuffer"
        ],
        "properties": {
          "baseCurrency": {
            "type": "string",
            "default": "USD"
          },
          "openingCash": {
            "type": "number"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Defaults to today (UTC) if omitted."
          },
          "horizonDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          },
          "minimumCashBuffer": {
            "type": "number",
            "minimum": 0
          },
          "cashFlows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "amount"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "amount": {
                  "type": "number",
                  "description": "Signed amount; positive is an inflow, negative is an outflow."
                },
                "category": {
                  "type": "string",
                  "maxLength": 50
                },
                "description": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "description": "Each date must be on or after startDate; dates beyond the horizon are excluded from the projection (and flagged in warnings/data_quality) rather than rejected."
          },
          "workingCapital": {
            "type": "object",
            "description": "Optional standard accounting ratios (DSO/DPO/DIO/cash conversion cycle) computed from a balance snapshot and period flow — independent of the cashFlows-based daily projection above.",
            "required": [
              "accountsReceivable",
              "accountsPayable",
              "periodCreditSales",
              "periodCOGS",
              "periodDays"
            ],
            "properties": {
              "accountsReceivable": {
                "type": "number",
                "minimum": 0,
                "description": "AR balance snapshot, in baseCurrency."
              },
              "accountsPayable": {
                "type": "number",
                "minimum": 0,
                "description": "AP balance snapshot, in baseCurrency."
              },
              "periodCreditSales": {
                "type": "number",
                "minimum": 0,
                "description": "Credit sales over the reference period, in baseCurrency."
              },
              "periodCOGS": {
                "type": "number",
                "minimum": 0,
                "description": "Cost of goods sold / purchases over the reference period, in baseCurrency."
              },
              "periodDays": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3650,
                "description": "Length of the reference period in days (e.g. 365 for a trailing year, 90 for a quarter)."
              },
              "inventory": {
                "type": "number",
                "minimum": 0,
                "description": "Optional inventory balance snapshot — enables days_inventory_outstanding and a full cash conversion cycle."
              }
            }
          }
        }
      },
      "example": {
        "openingCash": 800000,
        "startDate": "2026-09-14",
        "horizonDays": 30,
        "minimumCashBuffer": 500000,
        "cashFlows": [
          {
            "date": "2026-09-27",
            "amount": -500000,
            "category": "payable",
            "description": "Supplier invoice"
          }
        ]
      }
    },

    {
      "name": "fx_exposure",
      "route": "/fx-exposure",
      "price_usd": "0.25",
      "summary": "Deterministic FX exposure analysis",
      "description": "Computes gross/net exposure, currency concentration, natural hedges, stress scenarios, and hedge priority from a list of receivable/ payable/cash positions by currency. Requires USDC payment via the x402 protocol (Circle Gateway) — see the 402 response for the payment flow.",
      "inputSchema": {
        "type": "object",
        "required": [
          "positions",
          "fxRates"
        ],
        "properties": {
          "baseCurrency": {
            "type": "string",
            "default": "USD"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "currency",
                "type",
                "amount"
              ],
              "properties": {
                "currency": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "receivable",
                    "payable",
                    "cash"
                  ]
                },
                "amount": {
                  "type": "number",
                  "minimum": 0
                },
                "hedged": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
          "fxRates": {
            "type": "object",
            "description": "Units of baseCurrency per 1 unit of each foreign currency present in `positions`.",
            "additionalProperties": {
              "type": "number"
            }
          },
          "stressShockPct": {
            "type": "number",
            "description": "Fractional depreciation applied to each foreign currency in the stress scenario.",
            "default": 0.1
          },
          "totalTreasuryValueBase": {
            "type": "number",
            "description": "Optional total treasury value (in baseCurrency) used to normalize the risk score. Defaults to total gross FX exposure if omitted."
          }
        }
      },
      "example": {
        "baseCurrency": "USD",
        "positions": [
          {
            "currency": "EUR",
            "type": "receivable",
            "amount": 500000,
            "hedged": false
          },
          {
            "currency": "GBP",
            "type": "payable",
            "amount": 200000,
            "hedged": false
          }
        ],
        "fxRates": {
          "EUR": 1.08,
          "GBP": 1.27
        },
        "stressShockPct": 0.1
      }
